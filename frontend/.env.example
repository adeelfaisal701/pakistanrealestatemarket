# API Configuration
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:5000/api/v1

# App Configuration
NEXT_PUBLIC_APP_NAME="Pakistan Real Estate Marketplace & Agent CRM"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_HOSTNAME=admin.localhost

# Additional API/CDN image origins for Next Image and CSP (exact origins only).
# Production must use HTTPS origins; replace the placeholder with the deployed media host.
# CSP_IMAGE_ORIGINS=https://api.example.invalid

# Demo property cards are enabled automatically in development.
# Set to false to hide them locally; production remains disabled unless set true.
# NEXT_PUBLIC_ENABLE_DEMO_PROPERTIES=true

# Optional OpenStreetMap tile endpoint for exact-location maps. No API key is
# required for the default public tile endpoint; follow its usage policy.
# NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# WhatsApp Integration
NEXT_PUBLIC_WHATSAPP_PREFIX=https://wa.me/

{
  "name": "pak-real-estate-backend",
  "version": "0.0.1",
  "description": "Pakistan Real Estate Marketplace & Agent CRM Backend API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:dev:analytics": "node scripts/start-dev-analytics.js",
    "start:debug": "nest start --debug --watch",
    "prestart:prod": "npm run build",
    "start:prod": "node dist/main.js",
    "db:migrate:indexes": "node -r ts-node/register src/database/migrate-schema-indexes.ts",
    "admin:provision": "node scripts/provision-admin.js",
    "test": "node --test -r ts-node/register test/*.spec.ts test/*.spec.js",
    "test:registration": "node --test -r ts-node/register test/auth-registration.spec.ts",
    "test:admin-auth": "node --test -r ts-node/register test/admin-auth.spec.ts",
    "test:jwt-role": "node --test -r ts-node/register test/jwt-role.spec.js",
    "test:admin-moderation": "node --test -r ts-node/register test/admin-moderation.spec.ts",
    "test:admin-hard-delete-uri": "node --test -r ts-node/register test/admin-hard-delete-integration-uri.spec.ts",
    "test:admin-hard-delete-cleanup": "node --test -r ts-node/register test/admin-hard-delete-fixture-cleanup.spec.ts",
    "test:admin-hard-delete-integration": "node --test -r ts-node/register test/admin-hard-delete-replica-set.integration.spec.ts",
    "test:location-sharing": "node --test -r ts-node/register test/property-location-sharing.spec.ts",
    "test:property-images": "node --test -r ts-node/register test/property-images-and-features.spec.ts",
    "test:database-index-migration": "node --test -r ts-node/register test/schema-index-migration.spec.ts test/database-config.spec.ts",
    "test:cors": "node --test -r ts-node/register test/cors-config.spec.ts",
    "test:property-advertisements": "node --test -r ts-node/register test/property-advertisement-analytics.spec.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "mongoose": "^8.9.5",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}

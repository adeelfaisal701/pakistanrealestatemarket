# Server Configuration
PORT=5000
NODE_ENV=development
APP_NAME="Pakistan Real Estate & Agent CRM API"

# MongoDB Atlas Connection
MONGODB_URI=mongodb://127.0.0.1:27017/pak_real_estate
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/pak_real_estate?retryWrites=true&w=majority

# JWT Security
# REQUIRED. No default: the server refuses to start without it.
# Must be a random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_secret_and_put_it_in_your_local_env_file
JWT_EXPIRES_IN=7d

# Dedicated admin login. Configure real values in backend/.env only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_use_a_unique_strong_admin_password

# Development-only CORS origins. Production must explicitly configure CORS_ORIGIN
# with the approved HTTPS frontend and admin origins; localhost is rejected there.
CORS_ORIGIN=http://localhost:3000,http://admin.localhost:3000

# Private property location shares
# Buyer-bound links expire after 24 hours by default; allowed range is 1-720.
PROPERTY_LOCATION_SHARE_TTL_HOURS=24
# Required before agents can save/share exact locations. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PROPERTY_LOCATION_ENCRYPTION_KEY=
# Public frontend origin used when constructing private share links.
FRONTEND_BASE_URL=http://localhost:3000

# Persistent property image storage. In production, mount a durable volume at
# this path and set the public API origin reachable by browsers. Relative storage
# paths are resolved from the backend working directory.
PROPERTY_IMAGE_STORAGE_DIR=uploads/property-images
PROPERTY_IMAGE_PUBLIC_BASE_URL=http://localhost:5000/api/v1
